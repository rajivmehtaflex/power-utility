    loop For each .xlsx
        Normalize->>Normalize: normalize_xlsx() -> .parquet
    end
    
    Normalize-->>GDriveSync: List[Path] parquet files
    GDriveSync->>GDriveSync: Print parquet paths to stdout
    GDriveSync-->>Main: stdout with parquet paths
    
    Main->>Main: stage_gdrive_source_files(GDRIVE_MOUNT_PATH, data_dir)
    Note over Main: Copy supported files (.pdf, .docx, .pptx, .xlsx)<br/>from mount_path -> data_dir preserving structure
    
    Main->>Chainlit: run_chainlit_bootstrap(root_dir, xero_duckdb_path, xero_data_dir=data_dir)
    Chainlit-->>Main: DuckDB views refreshed
    end

    %% ==================== FINISH FLOW ====================
    rect rgb(240, 255, 240)
    note right of Main: FINISH FLOW (finish_flow) - Uses existing Xero DuckDB
    
    Main->>Main: load_dotenv(), create_s3_client()
    Main->>Main: upload_xero_duckdb() -> S3
    Main->>GDriveSync: run_gdrive_sync()
    GDriveSync->>Normalize: normalize_all() -> parquet files
    Normalize-->>GDriveSync: List[Path]
    GDriveSync-->>Main: stdout parquet paths
    Main->>Main: upload_gdrive_outputs() -> S3
    end

    %% ==================== MOUNT/UNMOUNT OPERATIONS ====================
    rect rgb(245, 245, 255)
    note right of GDriveMount: GOOGLE DRIVE MOUNT OPERATIONS (gdrive-manager.sh)
    
    alt Mount via gdrive_sync.mount()
        Main->>GDriveMount: gdrive_sync.mount(mount_path)
        GDriveMount->>GDriveMount: bash gdrive-manager.sh mount<br/>env: MOUNT_PATH=mount_path
        Note over GDriveMount: rclone mount remote: mount_path<br/>--vfs-cache-mode writes --daemon
        GDriveMount-->>Main: Mounted successfully
    end
    
    alt Mount Shared Folder
        Main->>GDriveMount: gdrive_sync.mount_shared(folder_id, mount_path)
        GDriveMount->>GDriveMount: bash gdrive-manager.sh mount-shared<br/>mount_path folder_id
        Note over GDriveMount: rclone mount remote:folder_id mount_path
        GDriveMount-->>Main: Shared folder mounted
    end
    
    alt Unmount
        Main->>GDriveMount: gdrive_sync.unmount(mount_path)
        GDriveMount->>GDriveMount: bash gdrive-manager.sh unmount<br/>mount_path
        Note over GDriveMount: fusermount -u mount_path
        GDriveMount-->>Main: Unmounted
    end
    
    alt Check Mount Status
        Main->>GDriveMount: gdrive_sync.is_mounted(mount_path)
        GDriveMount->>GDriveMount: mountpoint -q mount_path
        GDriveMount-->>Main: True/False
    end
    end

    %% ==================== NORMALIZATION DETAILS ====================
    rect rgb(255, 255, 240)
    note right of Normalize: LEDGER NORMALIZATION (normalize_ledgers.py)
    
    Normalize->>Normalize: find_xlsx_files(root) -> List[Path]
    Note over Normalize: Path(root).rglob("*.xlsx") - recursive
    
    Normalize->>Normalize: normalize_all(in_dir, out_dir, skip_rows)
    loop For each xlsx
        Normalize->>Normalize: normalize_xlsx(xlsx_path, out_dir, skip_rows)
        Note over Normalize: 1. openpyxl.load_workbook()<br/>2. ws = wb.active<br/>3. Skip first N rows (metadata)<br/>4. Row N = headers -> _standardize_headers()<br/>   - lowercase, snake_case, strip special chars<br/>5. Rows N+1.. = data -> list of lists<br/>6. pd.DataFrame(data, columns=headers)<br/>7. out_path = out_dir / (xlsx_name + .parquet)<br/>8. out_path.parent.mkdir(parents=True, exist_ok=True)<br/>9. df.to_parquet(out_path, index=False)<br/>10. Return out_path
    end
    
    Normalize-->>Normalize: List[Path] to parquet files
    end
