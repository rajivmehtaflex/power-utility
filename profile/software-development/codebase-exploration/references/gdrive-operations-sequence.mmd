    %% ==================== FULL INGESTION FLOW ====================
    rect rgb(240, 248, 255)
    note right of Main: FULL INGESTION PIPELINE (run_full_ingestion)
    
    Main->>Main: load_dotenv(), load_config()
    Main->>Main: create_s3_client()
    Main->>Main: get_xero_duckdb_path()
    Main->>Main: run_xero_sync() -> DuckDB created
    Main->>Main: upload_xero_duckdb() -> S3
    
    Main->>GDriveSync: run_gdrive_sync(root_dir, GDRIVE_PARQUET_DIR)
    Note over Main, GDriveSync: subprocess: uv run python main.py<br/>env: GDRIVE_PARQUET_DIR=/tmp/fcp-parquet
    
    GDriveSync->>Normalize: normalize_all(mount_path, parquet_dir, skip_rows)
    Note over GDriveSync, Normalize: mount_path = GDRIVE_MOUNT_PATH<br/>parquet_dir = /tmp/fcp-parquet
    
    Normalize->>GDriveMount: find_xlsx_files(mount_path) -> [file1.xlsx, file2.xlsx...]
    GDriveMount-->>Normalize: List of .xlsx files (recursive glob)
    
    loop For each .xlsx file
        Normalize->>Normalize: normalize_xlsx(xlsx_path, out_dir, skip_rows)
        Note over Normalize: 1. openpyxl load_workbook()<br/>2. Skip metadata rows (NORMALIZE_SKIP_ROWS)<br/>3. Read header row -> standardize headers<br/>4. Parse data rows -> DataFrame<br/>5. Write .parquet to parquet_dir<br/>6. Return Path to .parquet file
    end
    
    Normalize-->>GDriveSync: List[Path] to parquet files
    GDriveSync->>GDriveSync: Print each parquet path to stdout
    GDriveSync-->>Main: stdout with parquet file paths (one per line)
    
    Main->>Main: upload_gdrive_outputs(s3_client, gdrive_stdout, S3_BUCKET, today)
    Note over Main: Parse stdout lines -> validate .parquet exist<br/>Upload each to s3://ledgers/{company}/{today}/{file}.parquet
    
    Main->>Chainlit: run_chainlit_bootstrap(root_dir, xero_duckdb_path)
    Note over Main, Chainlit: subprocess: uv run python init_db.py<br/>env: XERO_DUCKDB_PATH
    
    Chainlit->>Chainlit: Refresh DuckDB views from updated DB
    Chainlit-->>Main: Bootstrap complete
    end

    %% ==================== GDRIVE-ONLY FLOW ====================
